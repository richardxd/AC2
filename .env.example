# Site configuration for the experiment launch scripts. Copy this file to .env (gitignored) and
# fill in your values. The scripts under experiments/ load .env automatically, and
# scripts/sbatch_env.sh substitutes these values into the #SBATCH headers before submitting.
#
# The launch scripts expect the repository checkout at $AC2_CLUSTER_<X>_ROOT/self-play on the
# cluster they target (most scripts also honor SELF_PLAY_ROOT). "Cluster A", "cluster B" and
# "cluster C" are the three SLURM clusters the runs used; the *_cluster_a / *_cluster_b /
# *_cluster_c scripts are written for them.

# ---- cluster A (run_attach_cluster_a.sh, submit_cluster_a_*.sbatch) -------------------------
AC2_CLUSTER_A_ROOT=/path/to/scratch            # holds self-play/, logs/, hf_home/, .cache/, fakehome/
AC2_CLUSTER_A_HOME=/path/to/home
AC2_CLUSTER_A_CUDA_COMPAT=/path/to/cuda-12.9/compat   # CUDA forward-compatibility libs (optional)
AC2_CLUSTER_A_MARKER=/path/present/only/on/cluster_a  # lets ac2.clusters detect the cluster
AC2_CLUSTER_A_ACCOUNT=your-slurm-account
AC2_CLUSTER_A_ACCOUNT_ALT=your-slurm-account
AC2_CLUSTER_A_PARTITION=your-partition

# ---- cluster B (run_attach_cluster_b.sh, submit_cluster_b_*.sbatch, launch_cluster_b.sh) -----
AC2_CLUSTER_B_ROOT=/path/to/scratch/work        # holds self-play/, data/, .cache/
AC2_CLUSTER_B_SCRATCH=/path/to/scratch          # holds .cache/huggingface/
AC2_CLUSTER_B_HOME=/path/to/home                # SLURM logs and allocation info files
AC2_CLUSTER_B_MARKER=/path/present/only/on/cluster_b
AC2_CLUSTER_B_ACCOUNT=your-slurm-account
AC2_CLUSTER_B_PARTITION=your-partition
AC2_CLUSTER_B_QOS=your-qos

# ---- cluster C (GRPO folders: run_attach_cluster_c.sh, submit_cluster_c_8node.sbatch) --------
AC2_CLUSTER_C_ROOT=/scratch/${USER}/ac2         # holds self-play/, hf-cache/, data/

# ---- shared --------------------------------------------------------------------------------
AC2_MAIL_USER=you@example.com                  # SLURM job e-mail
AC2_WANDB_ENTITY=your-wandb-entity
